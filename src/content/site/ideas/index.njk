---
title: "Idea Bank"
layout: "layouts/default.njk"
permalink: "/ideas/"
---

<main class="flex-grow">

<section class="max-w-6xl mx-auto px-6 pt-12 pb-10 text-center">
  <h1 class="text-4xl font-bold mb-4">Idea Bank</h1>

  <p class="text-lg text-muted max-w-2xl mx-auto">
    A place for ideas that could improve life in the Skagit Valley.
    Browse community ideas or plant one of your own.
  </p>

  <a href="/ideas/plant_a_seed/" class="btn btn-primary mt-6">
    Plant a New Idea 🌱
  </a>
</section>


{% set ideas = collections.ideas | reverse %}

{% if ideas | length %}
<section class="max-w-6xl mx-auto px-6 pb-20">

  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 justify-items-center">

    {% for idea in ideas %}

    <article class="bg-surface rounded-2xl shadow-sm p-6 flex flex-col items-center text-center max-w-[320px] w-full">

      {% if idea.data.featured_image %}
      <a href="{{ idea.url }}" class="block mb-4">
        {% image idea.data.featured_image, idea.data.title, {
            class: "w-full rounded-xl object-cover h-48"
        } %}
      </a>
      {% endif %}

      <a href="{{ idea.url }}" class="hover:text-accent">
        <h2 class="text-2xl font-semibold mb-3">
          {{ idea.data.title }}
        </h2>
      </a>

      {% if idea.data.summary %}
      <p class="text-fg">
        {{ idea.data.summary }}
      </p>
      {% endif %}

      {% if idea.data.tags %}
      <div class="flex flex-wrap justify-center gap-2 mt-4">
        {% for tag in idea.data.tags %}
          <span class="badge badge-outline">{{ tag }}</span>
        {% endfor %}
      </div>
      {% endif %}

    </article>

    {% endfor %}

  </div>

</section>
{% endif %}

</main>
