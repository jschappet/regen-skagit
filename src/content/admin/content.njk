---
layout: "layouts/admin.njk"
title: "Content Admin"
eleventyExcludeFromCollections: true
permalink: "/admin/content/"
---
<section x-data="contentAdmin()" class="max-w-7xl mx-auto px-6 py-10">

  <div class="flex h-[80vh] gap-6">

    <!-- Sidebar -->
    <aside class="w-64 shrink-0 border-r pr-4 space-y-4 overflow-y-auto">

      <button class="btn w-full btn-primary" @click="newDocument=true">
        + New Document
      </button>

      <div>
        <label class="label">Doc Type</label>
        <select x-model="filters.docType" @change="loadDrafts()" class="select select-bordered w-full">
          <option value="">All</option>
          <template x-for="type in docTypes" :key="type">
            <option :value="type" x-text="type"></option>
          </template>
        </select>
      </div>

      <div>
        <label class="label">Status</label>
        <select x-model="filters.status" @change="loadDrafts()" class="select select-bordered w-full">
          <option value="">All</option>
          <template x-for="status in statuses" :key="status">
            <option :value="status" x-text="status.replace('_',' ')"></option>
          </template>
        </select>
      </div>

      <div>
        <label class="label">Author</label>
        <input x-model="filters.author" @change="loadDrafts()" class="input input-bordered w-full">
      </div>

      <div>
        <label class="label">Date From</label>
        <input type="date" x-model="filters.dateFrom" @change="loadDrafts()" class="input input-bordered w-full">
      </div>

      <div>
        <label class="label">Date To</label>
        <input type="date" x-model="filters.dateTo" @change="loadDrafts()" class="input input-bordered w-full">
      </div>

    </aside>

    <!-- Main -->
    <main class="flex-1 overflow-y-auto space-y-4">

      <!-- Top Bar -->
      <div class="flex items-center justify-between">

        <!-- Bulk actions -->
        <div x-show="selected.size > 0" class="flex gap-2 bg-base-200 p-2 rounded">
          <span x-text="`${selected.size} selected`"></span>
          <button class="btn btn-success btn-sm" @click.stop="bulkApprove()">Approve</button>
          <button class="btn btn-warning btn-sm" @click="bulkRequestChanges()">Request Changes</button>
          <button class="btn btn-error btn-sm" @click="bulkReject()">Reject</button>
        </div>

        <!-- View toggle -->
        <div class="flex gap-2">
          <button 
            class="btn btn-sm"
            :class="view==='list' ? 'btn-active' : ''"
            @click="view='list'">
            List
          </button>
          <button 
            class="btn btn-sm"
            :class="view==='table' ? 'btn-active' : ''"
            @click="view='table'">
            Table
          </button>
        </div>

      </div>

      <!-- LIST VIEW -->
      <div x-show="view === 'list'" class="divide-y rounded-lg border bg-white">

        <template x-for="draft in drafts" :key="draft.id">
          <div 
            class="p-4 hover:bg-base-100 cursor-pointer"
            @click="openDraft(draft)"
          >

            <!-- Row -->
            <div class="flex items-start gap-3">

              <!-- Checkbox -->
              <input 
                type="checkbox"
                class="checkbox mt-1"
                :checked="selected.has(draft.id)"
                @click.stop
                @change="toggleOne(draft.id, $event.target.checked)"
              >

              <div class="flex-1">

                <!-- Title + time -->
                <div class="flex justify-between">
                  <div class="font-medium">
                    <span x-text="draft.title || '(Untitled)'"></span>
                  </div>
                  <div class="text-sm text-gray-500">
                    <span x-text="formatDate(draft.submitted_at)"></span>
                  </div>
                </div>

                <!-- Meta -->
                <div class="text-sm text-gray-500 mt-1 flex gap-2">
                  <span x-text="draft.doc_type"></span>
                  <span>•</span>
                  <span x-text="draft.author"></span>
                </div>

                <!-- Status + actions -->
                <div class="flex items-center justify-between mt-2">

                  <div class="flex items-center gap-2">

                    <!-- Status icon -->
                    <span>
                      <template x-if="draft.status === 'approved'">✅</template>
                      <template x-if="draft.status === 'submitted'">⏳</template>
                      <template x-if="draft.status === 'changes_requested'">⚠️</template>
                    </span>

                    <span class="badge"
                      :class="{
                        'badge-warning': draft.status==='submitted',
                        'badge-info': draft.status==='changes_requested',
                        'badge-success': draft.status==='approved'
                      }"
                      x-text="draft.status.replace('_',' ')"></span>

                  </div>

                  <div class="flex gap-2">
                    <button 
                      class="btn btn-xs btn-outline"
                      @click.stop="openPreview(draft.body_md)">
                      Preview
                    </button>

                    <a 
                      @click.stop
                      :href="editorUrl(draft.doc_type, draft.id)"
                      class="btn btn-xs btn-outline">
                      Edit
                    </a>
                  </div>

                </div>

              </div>
            </div>

          </div>
        </template>
      </div>

      <!-- TABLE VIEW -->
      <div x-show="view === 'table'" class="overflow-x-auto bg-white rounded-lg shadow">

        <table class="table table-zebra w-full">
          <thead>
            <tr>
              <th>
                <input type="checkbox" class="checkbox" @change="toggleAll($event.target.checked)">
              </th>
              <th @click="sortBy('doc_type')" class="cursor-pointer">Doc Type</th>
              <th @click="sortBy('title')" class="cursor-pointer">Title</th>
              <th @click="sortBy('author')" class="cursor-pointer">Author</th>
              <th @click="sortBy('status')" class="cursor-pointer">Status</th>
              <th @click="sortBy('submitted_at')" class="cursor-pointer">Submitted</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>

          <tbody>
            <template x-for="draft in drafts" :key="draft.id">
              <tr class="hover:bg-base-200 cursor-pointer">

                <td>
                  <input type="checkbox"
                    class="checkbox"
                    :checked="selected.has(draft.id)"
                    @change="toggleOne(draft.id, $event.target.checked)">
                </td>

                <td x-text="draft.doc_type"></td>

                <td @click="openDraft(draft)" class="font-medium">
                  <span x-text="draft.title"></span>
                </td>

                <td x-text="draft.author"></td>

                <td>
                  <span class="badge"
                    :class="{
                      'badge-warning': draft.status==='submitted',
                      'badge-info': draft.status==='changes_requested',
                      'badge-success': draft.status==='approved'
                    }"
                    x-text="draft.status.replace('_',' ')"></span>
                </td>

                <td x-text="formatDate(draft.submitted_at)"></td>

                <td class="text-right space-x-2">
                  <button class="btn btn-sm btn-outline" @click.stop="openPreview(draft.body_md)">Preview</button>
                  <a :href="editorUrl(draft.doc_type, draft.id)" class="btn btn-sm btn-outline">Edit</a>
                </td>

              </tr>
            </template>
          </tbody>
        </table>
      </div>
<!-- New Document Modal -->
<div 
  x-show="newDocument" 
  x-transition 
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/50"
  @keydown.escape.window="newDocument=false"
>

  <div class="bg-white w-full max-w-md rounded-lg shadow-xl p-6">

    <!-- Header -->
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-semibold">New Document</h2>
      <button class="btn btn-sm btn-circle" @click="newDocument=false">✕</button>
    </div>

    <!-- Options -->
    <div class="grid grid-cols-2 gap-3">

      <template x-for="doc in docTypes" :key="doc">
        <a
          class="btn btn-outline w-full justify-start"
          :href="editorUrl(doc)"
          x-text="doc"
        ></a>
      </template>

    </div>

  </div>
</div>
    </main>
  </div>

</section>

<script>
  function contentAdmin() {
    return {
      view: 'list', // default to GitHub-style
      drafts: [],
      newDocument: false,
      docTypes: [
        'organization', 'event', 'post', 'idea', 'experiment', 'results'
      ],
      statuses: [
        'draft', 'submitted', 'changes_requested', 'approved', 'deployed'
      ],
      authors: [],
      filters: {
        docType: '',
        status: '',
        author: '',
        dateFrom: '',
        dateTo: ''
      },

      selected: new Set(),
      previewOpen: false,
      previewMarkdown: '',
      sortKey: null,
      sortAsc: true,

      sortBy(key) {
        if (this.sortKey === key) {
          this.sortAsc = !this.sortAsc;
        } else {
          this.sortKey = key;
          this.sortAsc = true;
        }

        this
          .drafts
          .sort((a, b) => {
            let A = a[key] ?? '';
            let B = b[key] ?? '';

            if (key === 'submitted_at') {
              A = A
                ? new Date(A)
                : 0;
              B = B
                ? new Date(B)
                : 0;
            }

            if (typeof A === 'string') {
              A = A.toLowerCase();
              B = B.toLowerCase();
            }

            if (A < B) 
              return this.sortAsc
                ? -1
                : 1;
            if (A > B) 
              return this.sortAsc
                ? 1
                : -1;
            return 0;
          });
      },

      async init() {
        await this.loadDrafts();
      },

      async loadDrafts() {
        try {
          console.log("Filters: ", this.filters);
          const data = await Alpine
            .store("api")
            .call("draft_list", this.filters);

          this.drafts = data
            ?.drafts ?? [];

          if (this.sortKey) 
            this.sortBy(this.sortKey);

          }
        catch (e) {
          console.error("Failed loading drafts", e);
        }
      },

      openPreview(md) {
        this.previewMarkdown = marked.parse(md || '');
        this.previewOpen = true;
      },

      toggleOne(id, checked) {
        checked
          ? this
            .selected
            .add(id)
          : this
            .selected
            .delete(id);
      },

      toggleAll(checked) {
        this
          .selected
          .clear();
        if (checked) {
          this
            .drafts
            .forEach(d => this.selected.add(d.id));
        }
      },

      formatDate(ts) {
        return ts
          ? new Date(ts).toLocaleDateString()
          : '';
      },

      async bulkApprove() {
        if (!this.selected.size) 
          return;
        
        await Alpine
          .store("api")
          .call("draft_bulk_approve", {}, {
            ids: [...this.selected]
          });

        this
          .selected
          .clear();
        this.loadDrafts();
      },

      async bulkRequestChanges() {
        const notes = prompt('Notes for changes?');
        if (!notes) 
          return;
        
        // uses single draft endpoint for bulk change if backend supports notes
        await Alpine
          .store("api")
          .call("request_changes_api", {}, {
            ids: [...this.selected],
            notes
          });

        this
          .selected
          .clear();
        this.loadDrafts();
      },

      async bulkReject() {
        if (!this.selected.size) 
          return;
        if (!confirm('Reject selected drafts?')) 
          return;
        
        await Alpine
          .store("api")
          .call("delete_draft_api", {}, {
            ids: [...this.selected]
          });

        this
          .selected
          .clear();
        this.loadDrafts();
      },

      editorUrl(type, id) {
        const base = ['experiment', 'results'].includes(type) ? `/admin/content/${type}/` : '/admin/content/edit/';
        const params = new URLSearchParams({doc_type: type});
        if (id) params.set('id', id);
        return `${base}?${params.toString()}`;
      },
      openDraft(draft) {
        window.location.href = this.editorUrl(draft.doc_type, draft.id);
      }
    }
  }
</script>