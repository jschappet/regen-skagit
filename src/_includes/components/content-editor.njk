<link rel="stylesheet" href="https://uicdn.toast.com/editor/3.2.2/toastui-editor.min.css">
<link rel="stylesheet" href="https://uicdn.toast.com/editor/3.2.2/theme/toastui-editor-dark.min.css">
<script src="https://uicdn.toast.com/editor/3.2.2/toastui-editor-all.min.js"></script>
<script src="/assets/js/content-access.js"></script>
<script src="/assets/js/content-editor.js"></script>
<form x-ref="editorForm" x-data="documentForm()" x-show="signedIn || error" x-cloak novalidate
  x-on:submit.prevent="submit" class="heron-content content-editor max-w-4xl mx-auto p-4 sm:p-8 rounded-lg space-y-6">
  {% include "components/content-nav.njk" %}
  <a class="link" :href="returnUrl">← Back to content</a>
  <header class="editor-heading">
    <div><p class="editor-eyebrow" x-text="schema.label || 'Create something new'"></p>
    <h1 x-text="doc.title || 'Untitled draft'"></h1>
    <p class="editor-muted">A little detail, your story, and the images that bring it to life.</p></div>
    <span class="badge badge-outline" x-text="(doc.status || 'draft').replaceAll('_', ' ')"></span>
  </header>
  <p x-show="loading" role="status">Loading editor…</p>
  <div x-show="error" class="alert alert-error" role="alert" x-text="error"></div>
  <div x-show="ui_message" class="alert alert-info" role="status" x-text="ui_message"></div>
  <p x-show="!loading && !canEdit">This content is <span x-text="doc.status"></span>. It is available to read while awaiting review or publication.</p>
  <nav class="editor-steps" aria-label="Editor pages">
    <template x-for="page in editorPages" :key="page.number">
      <button type="button" :aria-current="step === page.number ? 'step' : null" x-on:click="goToStep(page.number)" :disabled="loading">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path :d="page.icon"></path></svg>
        <span><small x-text="'Page ' + page.number"></small><strong x-text="page.label"></strong></span>
      </button>
    </template>
  </nav>
  <fieldset :disabled="loading || busy || !canEdit" class="space-y-6">
    <section x-show="step === 1" aria-label="Metadata"><h2>First, the details</h2><p class="editor-muted">Give your content a title and a few details so others can find it.</p></section>
    <section x-show="step === 3" aria-label="Images"><h2>Add your images</h2><p class="editor-muted">Upload images, add descriptions, then insert them into your content.</p><p x-show="!schema.fields.some(f => f.type === 'images')">This content type has no image collection. You can add an image by URL in the content editor.</p></section>
    <div class="editor-fields">
            <template x-if="schema && Array.isArray(schema.fields)">
                <template x-for="field in schema.fields" :key="field.key">
                    <template x-if="field.key !== 'body_md' && field.type !== 'hidden'">
                        <div x-show="step === (field.type === 'images' ? 3 : 1)">
                            <label class="label" :for="'content-' + field.key">
                                <span x-text="field.label"></span><span x-show="field.key === 'author' && !isAdmin" class="editor-muted"> · Set from your profile</span>
                                <span x-show="field.required" class="text-red-500">*</span>
                            </label>

                            <!-- Text -->
                            <template x-if="field.type === 'text'">
                                <input
                  type="text"
                  class="input input-bordered w-full"
                  x-model="doc[field.key]" :id="'content-' + field.key" :readonly="field.readonly === true || (field.key === 'author' && !isAdmin)"
                  :required="field.required === true"
/>
                            </template>
                            <!-- Text -->
                            <template x-if="field.type === 'number'">
                                <input
                  type="number"
                  class="input input-bordered w-full"
                  x-model.number="doc[field.key]" :id="'content-' + field.key"
                  :required="field.required === true"
/>
                            </template>

                            <!-- Textarea -->
                            <template x-if="field.type === 'textarea'">
                                <textarea
                  class="textarea textarea-bordered w-full"
                  rows="3"
                  x-model="doc[field.key]" :id="'content-' + field.key" :readonly="field.readonly === true || (field.key === 'author' && !isAdmin)"
                  :required="field.required === true"
                ></textarea>
                            </template>
                            <!-- Checkboxes -->
                            <template x-if="field.type === 'checkbox'">
                                <div class="space-y-2">
                                    <template x-for="opt in field.options" :key="opt.label">
                                        <label class="flex items-center gap-2 cursor-pointer">
                                            <input
          type="checkbox"
          class="checkbox"
          :checked="doc[field.key] && doc[field.key].includes(opt.value)"
          @change="handleCheckboxChange(field.key, opt.value, $event.target.checked)"
/>
                                            <span x-text="opt.label"></span>
                                        </label>
                                    </template>
                                </div>
                            </template>

                            <!-- Hidden -->
                            <template x-if="field.type === 'hidden'">
                                <input type="hidden" x-model="doc[field.key]" :id="'content-' + field.key" :readonly="field.readonly === true || (field.key === 'author' && !isAdmin)"/>
                            </template>

                            <!-- Date -->
                            <template x-if="field.type === 'date'">
                                <input type="date" class="input input-bordered w-full" x-model="doc[field.key]" :id="'content-' + field.key" :readonly="field.readonly === true || (field.key === 'author' && !isAdmin)"/>
                            </template>

                            <!-- Images -->
<!-- Images -->
<template x-if="field.type === 'images'">
    <div class="space-y-3" x-data="{ editingImageIndex: null }">
        <div class="flex items-center justify-between">
            <p class="text-sm text-base-content/60">
                <span x-text="doc[field.key]?.length || 0"></span> image(s)
            </p>
            <button
                type="button"
                class="btn btn-sm btn-primary"
                x-on:click="editingImageIndex = null; $refs.imageModal.showModal()"
            >
                Manage images
            </button>
        </div>

        <template x-if="!doc[field.key]?.length">
            <p class="rounded-lg border border-dashed border-base-300 p-4 text-sm text-base-content/60">
                No images uploaded yet.
            </p>
        </template>

        <div class="divide-y divide-base-300 overflow-hidden rounded-lg border border-base-300">
            <template x-for="(image, index) in (doc[field.key] || [])" :key="image.url">
                <div class="flex items-center gap-3 p-2">
                    <img
                        :src="image.url"
                        :alt="image.alt || image.name"
                        class="h-10 w-10 shrink-0 rounded object-cover"
                    >

                    <button
                        type="button"
                        class="min-w-0 flex-1 truncate text-left text-sm hover:text-primary"
                        :title="image.name || image.alt || 'Untitled image'"
                        x-on:click="editingImageIndex = index; $refs.imageModal.showModal()"
                        x-text="image.name || image.alt || `Image ${index + 1}`"
                    ></button>

                    <button
                        type="button"
                        class="btn btn-xs"
                        title="Insert into content"
                        x-on:click="insertMarkdownImage(image)"
                    >
                        Insert into content
                    </button>
                </div>
            </template>
        </div>

        <dialog x-ref="imageModal"
    class="modal modal-middle fixed inset-0 z-50 m-auto h-fit 
        max-h-[calc(100vh-2rem)] w-full max-w-2xl p-0">
            <div class="modal-box max-w-2xl">
                <div class="mb-4 flex items-center justify-between">
                    <h3 class="text-lg font-bold">
                        <span x-show="editingImageIndex === null">Manage images</span>
                        <span x-show="editingImageIndex !== null">Edit image</span>
                    </h3>
                    <button
                        type="button"
                        class="btn btn-sm btn-circle btn-ghost"
                        x-on:click="$refs.imageModal.close()"
                     aria-label="Close images">✕</button>
                </div>

                <div
                    class="rounded-lg border-2 border-dashed border-base-300 p-4 text-center"
                    :class="isDraggingFiles ? 'border-primary bg-primary/5' : ''"
                    @dragover.prevent="isDraggingFiles = true"
                    @dragleave.prevent="isDraggingFiles = false"
                    @drop.prevent="uploadImages($event.dataTransfer.files, field.key)"
                >
                    <p class="text-sm">Drop images here, or choose files</p>
                    <input
                        type="file"
                        accept="image/*"
                        multiple
                        class="file-input file-input-bordered file-input-sm mt-3 w-full"
                        @change="uploadImages($event.target.files, field.key); $event.target.value = ''"
                    >
                    <p x-show="uploadingImages" class="mt-2 text-sm text-primary">
                        Uploading images…
                    </p>
                </div>

                <template x-if="editingImageIndex !== null && doc[field.key]?.[editingImageIndex]">
                    <div class="mt-5 space-y-4">
                        <img
                            :src="doc[field.key][editingImageIndex].url"
                            :alt="doc[field.key][editingImageIndex].alt"
                            class="h-36 w-full rounded-lg object-cover"
                        >

                        <label class="form-control">
                            <span class="label-text mb-1">Image title</span>
                            <input
                                class="input input-bordered w-full"
                                type="text"
                                placeholder="Name"
                                x-model="doc[field.key][editingImageIndex].name"
                            >
                        </label>

                        <label class="form-control">
                            <span class="label-text mb-1">Alt text</span>
                            <input
                                class="input input-bordered w-full"
                                type="text"
                                placeholder="Describe the image"
                                x-model="doc[field.key][editingImageIndex].alt"
                            >
                        </label>

                        <label class="form-control">
                            <span class="label-text mb-1">Image URL</span>
                            <input
                                class="input input-bordered w-full font-mono text-xs"
                                type="url"
                                placeholder="Image URL"
                                x-model="doc[field.key][editingImageIndex].url"
                            >
                        </label>

                        <div class="flex justify-between gap-2">
                            <button
                                type="button"
                                class="btn btn-sm"
                                x-on:click="copyMarkdownImage(doc[field.key][editingImageIndex])"
                            >
                                Copy Markdown
                            </button>

                            <button
                                type="button"
                                class="btn btn-sm btn-error"
                                x-on:click="
                                    doc[field.key].splice(editingImageIndex, 1);
                                    editingImageIndex = null;
                                    $refs.imageModal.close();
                                "
                            >
                                Delete image
                            </button>
                        </div>
                    </div>
                </template>

                <template x-if="editingImageIndex === null">
                    <p class="mt-4 text-sm text-base-content/60">
                        Upload an image above, then select it from the list to edit its details.
                    </p>
                </template>
            </div>

            <button type="button" class="modal-backdrop" aria-label="Close images" x-on:click="$refs.imageModal.close()"></button>
        </dialog>
    </div>
</template>
                            <!-- Tags -->
                            <template x-if="field.type === 'tags'">
                                <input
                  type="text"
                  class="input input-bordered w-full"
                  placeholder="comma separated"
                  x-model="doc[field.key]" :id="'content-' + field.key" :readonly="field.readonly === true || (field.key === 'author' && !isAdmin)"
/>
                            </template>

                            <!-- Select -->
                            <template x-if="field.type === 'select'">
                                <select
                  class="select select-bordered w-full"
                  :required="field.required === true"
                  x-model="doc[field.key]" :id="'content-' + field.key" :readonly="field.readonly === true || (field.key === 'author' && !isAdmin)"
                >
                                    <option value="">Select…</option>
                                    <template x-for="opt in field.options" :key="opt.label">
                                        <option :value="opt.value" x-text="opt.label"></option>
                                    </template>
                                </select>
                            </template>

                            <!-- Multi Select -->
                            <template x-if="field.type === 'multiselect'">
                                <select
        class="select select-bordered w-full"
        :required="field.required === true"
        x-model="doc[field.key]" :id="'content-' + field.key" :readonly="field.readonly === true || (field.key === 'author' && !isAdmin)"
        multiple
    >
                                    <template x-for="opt in field.options" :key="opt.value">
                                        <option :value="opt.value" x-text="opt.label"></option>
                                    </template>
                                </select>
                            </template>
                        </div>
                    </template>
                </template>
            </template>


    </div>
    <section x-show="step === 2" aria-label="Content" class="space-y-4">
      <h2>Tell your story</h2>
      <p class="editor-muted">Write and format naturally. Your content is saved as Markdown.</p>
      <div x-show="schema.has_markdown && canEdit" x-ref="visualEditor" :inert="busy || uploadingImages"><div x-ignore></div></div>
      <div x-show="schema.has_markdown && !canEdit" class="prose max-w-none" x-html="renderedMarkdown"></div>
      <div x-show="schema.has_markdown && editorUnavailable && canEdit">
        <p role="status">The visual editor could not load. You can still edit and save Markdown below.</p>
        <textarea x-ref="markdownEditor" x-model="doc.body_md" aria-label="Markdown content" rows="18" class="textarea textarea-bordered w-full font-mono"></textarea>
      </div>
      <p x-show="!schema.has_markdown">This content type uses the details on page one and has no separate content body.</p>
    </section>
  </fieldset>
  <footer class="editor-actions">
    <div class="flex gap-2">
      <button type="button" class="btn btn-outline" x-show="step > 1" x-on:click="goToStep(step - 1)">← Back</button>
      <button type="button" class="btn btn-outline" x-show="step < 3" x-on:click="goToStep(step + 1)">Next →</button>
    </div>
    <div class="flex flex-wrap gap-2" x-show="canEdit">
      <button type="button" class="btn btn-outline" :disabled="loading || busy || uploadingImages" x-on:click="save()"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 3h12l4 4v14H3V3h2Zm2 0v6h10V3M7 21v-8h10v8"/></svg>Save draft</button>
      <button type="submit" class="btn btn-primary" :disabled="loading || busy || uploadingImages" x-show="!doc.status || ['draft', 'changes_requested'].includes(doc.status)"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m3 11 18-8-8 18-2-8-8-2Zm8 2L21 3"/></svg>Submit for review</button>
    </div>
  </footer>
</form>
