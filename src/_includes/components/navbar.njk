{% set navPages = collections.all | eleventyNavigation %}

<header class="w-full shadow-sm">
  <nav class="navbar w-full max-w-7xl mx-auto
              bg-surface dark:bg-surface-dark text-fg ">

    <!-- Left: Logo + Mobile Dropdown -->
    <div class="navbar-start">

      <!-- Mobile dropdown -->
      <div class="dropdown lg:hidden">
        <label tabindex="0" class="btn btn-square btn-ghost mobile-menu-btn">
          <i class="fi fi-rr-menu-burger text-lg"></i>
        </label>

        <ul tabindex="-1"
  class="menu menu-sm dropdown-content rounded-box z-50 mt-3 w-52 p-2
         bg-surface 
         border border-black/10
         shadow-lg backdrop-blur-sm
         text-fg ">

          {% for entry in navPages %}
            <li>
              <a href="{{ entry.url | url }}" class="block py-1 hover:text-accent ">
                {{ entry.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>

      <!-- Logo -->
      <a href="/" class=" text-xl text-fg ">
        Regenerate Skagit
      </a>
    </div>

    <!-- Center: Desktop Menu -->
    <div class="navbar-center hidden lg:flex">
      <ul class="menu menu-horizontal px-1 text-fg dark:text-fg-dark">
        {% for entry in navPages %}
          <li>
            <a href="{{ entry.url | url }}" class="block py-1 hover:text-accent dark:hover:text-accent">
              {{ entry.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
<div class="navbar-end" >

  <!-- Logged OUT -->
  {# <template x-if="!$store.auth.authenticated && $store.auth.loaded">
    <a href="/login" class="btn btn-primary btn-sm">
      Login
    </a>
  </template> #}

  <!-- Logged IN -->
  <template x-if="$store.auth.authenticated">
    <div class="dropdown dropdown-end">
      
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
        <div class="w-10 rounded-full bg-primary text-primary-content flex items-center justify-center">
          <span x-text="$store.auth.user?.name?.charAt(0) ?? 'U'"></span>
        </div>
      </div>

      <ul tabindex="0"
          class="mt-3 z-1 p-2 shadow menu menu-sm dropdown-content bg-base-100 rounded-box w-52">

        <li class="menu-title px-2 py-1">
          <span x-text="$store.auth.user?.name"></span>
        </li>

        <li>
          <a href="/member/profile/">Profile</a>
        </li>
        <li x-show="$store.auth.hasRole('admin')">
          <a href="/admin/">Edit Content</a>
        </li>
        <li x-show="$store.auth.hasRole('admin')">
          <a href="/admin/ledger/">Ledger</a>
        </li>
        <li x-show="$store.auth.hasRole('admin')">
          <a href="/admin/workbench/">Workbench</a>
        </li>

        <li>
          <a href="/settings/">Settings</a>
        </li>

        <li>
          <button
            @click="localStorage.removeItem('auth_token'); location.reload();">
            Logout
          </button>
        </li>

      </ul>
    </div>
  </template>

</div>
    <!-- Right: Theme Toggle -->
    {# Disableing theme toggle for now since it doesn't work well with DaisyUI's dark mode and we don't have a good custom solution yet. #}
    {# 
    <div class="navbar-end">
      <button id="theme-toggle"
        class="btn btn-ghost relative "
        aria-label="Toggle theme">
        <!-- Sun (show in dark mode) -->
        <i id="sun-icon" class="fi fi-br-brightness absolute hidden dark:inline"></i>
        <i id="moon-icon" class="fi fi-br-moon absolute inline dark:hidden"></i>

      </button>

    </div>
    #}
  </nav>
</header>